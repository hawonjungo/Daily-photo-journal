# Local development only needs the POSTGRES_* values.
# Use a hex password (openssl rand -hex 24): characters such as ; would break the connection string.
POSTGRES_DB=relifes
POSTGRES_USER=relifes
POSTGRES_PASSWORD=change-me

# Everything below is for production (docker-compose.prod.yml).
DOMAIN=photo.relifes.net

# Private Cloudflare R2 bucket and an API token with read and write access to it.
R2_SERVICE_URL=https://<account id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional. Without a key, place names are always typed by hand.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_DAILY_CAP=150

# Used for uploads that send no timeZone.
DEFAULT_TIME_ZONE=Asia/Ho_Chi_Minh

# Optional. Defaults to R2_BUCKET, under the backups/ prefix, keeping 30 days.
# BACKUP_BUCKET=
# BACKUP_PREFIX=backups
# BACKUP_RETENTION_DAYS=30
