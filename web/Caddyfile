{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	# File names under /assets contain a content hash, so they never change.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	# These must be revalidated, or installed apps would not pick up new versions.
	@revalidate path / /index.html /sw.js /registerSW.js /manifest.webmanifest
	header @revalidate Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
